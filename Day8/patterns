#---------------star pattern-------------------#
n=4
for i in range(1,n+1):
    for j in range(1,i+1):
        print("*",end="")
    print()    
#---------reverse star pattern -------------------#   
n=4
for i in range(1,n+1):
    for j in range(1,n-i+2):
        print("*",end="")
    print()    
    
#-----------number pattern-----------------#
n=4
for i in range(1,n+1):
    for j in range(1,i+1):
        print(j,end="")
    print()  
    
n=4
for i in range(1,n+1):
    for j in range(1,i+1):
        print(i,end="")
    print()    
    
#-----------reverse number pattern ------------------#
n=4
for i in range(1,n+1):
    for j in range(1,n-i+2):
        print(j,end="") 
    print()       
    
    
#----------pyramid pattern------------------#
n=4
for i in range(1,n+1):
    print(" "*(n-i),end=" ")
    print("*" * (2*i-1))   
    
    
#---------reverse pyramid pattern-----------------#
n=4
for i in range(1,n+1):
    print(""*(i-1),end="")
    print("*"*(2*(n-i)+1))